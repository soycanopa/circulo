{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Circulo",
  "version": "0.1.0",
  "identifier": "com.soycanopa.circulo",
  "build": {
    "beforeDevCommand": "bun run sidecar:dev && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sidecar:build && bun run build",
    "beforeBundleCommand": "bun run sidecar:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Circulo",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/circulo-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
